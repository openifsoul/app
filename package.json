{
  "name": "@ifsoul/app",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "description": "Self-hostable IfSoul App and reusable local/cloud UI",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.18 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/tooling/*.test.mjs && tsx --test tests/service/*.test.ts tests/server/*.test.ts tests/lab/*.test.ts",
    "check": "pnpm check:version && pnpm typecheck && pnpm test",
    "build:web": "vite build --config apps/laboratory/vite.config.ts",
    "start": "tsx apps/server/src/local.ts",
    "lab": "tsx apps/runtime-host/src/cli.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "pnpm build:server && pnpm build:web",
    "check:version": "node scripts/check-version.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "files": [
    "apps",
    "LICENSE",
    "NOTICE",
    "README.md",
    "vendor",
    "dist/server",
    "LICENSES",
    "docs",
    "release.json"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./browser": "./apps/laboratory/src/browser.ts",
    "./styles.css": "./apps/laboratory/src/styles.css",
    "./server": {
      "types": "./dist/server/apps/server/src/index.d.ts",
      "import": "./dist/server/apps/server/src/index.js"
    },
    "./server/api": {
      "types": "./dist/server/apps/server/src/api.d.ts",
      "import": "./dist/server/apps/server/src/api.js"
    },
    "./server/security": {
      "types": "./dist/server/apps/server/src/security.d.ts",
      "import": "./dist/server/apps/server/src/security.js"
    },
    "./ui/button": "./apps/laboratory/src/components/ui/button.tsx",
    "./ui/card": "./apps/laboratory/src/components/ui/card.tsx",
    "./ui/alert-dialog": "./apps/laboratory/src/components/ui/alert-dialog.tsx",
    "./ui/input": "./apps/laboratory/src/components/ui/input.tsx",
    "./ui/badge": "./apps/laboratory/src/components/ui/badge.tsx",
    "./ui/label": "./apps/laboratory/src/components/ui/label.tsx",
    "./ui/tabs": "./apps/laboratory/src/components/ui/tabs.tsx",
    "./ui/message": "./apps/laboratory/src/components/ui/message.tsx"
  },
  "dependencies": {
    "@ifsoul/core": "file:vendor/ifsoul-core-0.4.0.tgz",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@gsap/react": "2.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gsap": "3.15.1",
    "lucide-react": "1.69.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "@ifsoul/adapter-sdk": "file:vendor/ifsoul-adapter-sdk-0.4.0.tgz"
  },
  "bundledDependencies": [
    "@ifsoul/core",
    "@ifsoul/adapter-sdk"
  ]
}
